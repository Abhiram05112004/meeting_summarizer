# ========================================
# Meeting Summarizer - Environment Variables
# ========================================
# Copy this file to .env and fill in your API keys
# The .env file will be ignored by git for security

# ========================================
# AssemblyAI API Key
# ========================================
# Get your API key from: https://www.assemblyai.com/
# This is used for audio transcription
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ========================================
# Google Gemini API Key
# ========================================
# Get your API key from: https://ai.google.dev/
# This is used for AI-powered summarization
GEMINI_API_KEY=your_gemini_api_key_here

# ========================================
# Optional: Alternative Gemini Key Name
# ========================================
# If you prefer, you can use GOOGLE_API_KEY instead
# The app will check both variables
# GOOGLE_API_KEY=your_gemini_api_key_here

# ========================================
# Application Configuration (Optional)
# ========================================
# Uncomment and modify if needed

# Backend server port (default: 8000)
# PORT=8000

# Frontend URL for CORS (default: all origins in dev)
# FRONTEND_URL=http://localhost:5173

# Database path (default: meeting_history.db in backend folder)
# DATABASE_PATH=meeting_history.db

# Upload directory (default: backend/uploads)
# UPLOAD_DIR=uploads

# Max file size in MB (default: 100)
# MAX_FILE_SIZE_MB=100

# ========================================
# Instructions
# ========================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your API keys above
# 3. Never commit the .env file to git
# 4. Keep your API keys secure and private
